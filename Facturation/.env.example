# Base de données (SQLite par défaut, aucune installation requise)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="change-moi-en-production"
NEXTAUTH_URL="http://localhost:3000"

# Envoi d'emails (relances, envoi de factures). Laisser vide en dev :
# les emails sont alors simplement journalisés dans la console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Facturation Intelligente <factures@exemple.fr>"

# Clé partagée pour protéger les endpoints de tâches planifiées (cron)
CRON_SECRET="change-moi-aussi"
